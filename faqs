      #error{background-color: #CD5C5C; text-align: center; font-size: 16px;}
    </style>
    <script>
      function validate(){
var name1=document.getElementById("name").value;
var phone1=document.getElementById("phone").value;
var email1=document.getElementById("email").value;
var message1=document.getElementById("message").value;

        if(name1.length<5){
          text="Please enter your full name";
          error.innerHTML=text;
          return false;
      }

        if(isNaN(phone1) || phone1.length!=10){
          text="Please enter a vaild phone number";
          error.innerHTML=text;
          return false;
        }

        if(email1.indexOf("@")==-1 || email1.length<6){
            text="Please enter a vaild email";
          error.innerHTML=text;
          return false;
        }

        if(message1.length<=10){
            text="Please enter more than 10 characters";
          error.innerHTML=text;
          return false;
        }

        alert("Form submitted successfully")
        return true;
      }
    </script>
