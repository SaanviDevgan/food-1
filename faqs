    <style>
       body{background-color: #FFF8DC;}
      header{width: 100%; height: 100px; text-align: center;}
      nav ul li{list-style-type: none; display: inline-block; font-size: 25px; font-weight: bold;}
      nav ul li a{text-decoration: none; color: #556B2F; font-size: 25px; margin: 10px;}
      .wrapper{position: absolute; top: 175px; left: 500px; width: 500px; padding: 25px; background-color: #F5FFFA;}
